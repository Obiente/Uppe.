---
import Card from './ui/Card.astro';
import StatusBadge from './ui/StatusBadge.astro';
import MetricItem from './ui/MetricItem.astro';
import UptimeHistoryBar from './ui/UptimeHistoryBar.astro';
import { badgeStatus, type HistoryBucket } from '../lib/services/history';
interface Props { monitors: Array<{id:string;name:string;url:string;state:string;uptime:number|null;avgPing:number|null;totalChecks:number|null;history:HistoryBucket[];lastCheck:string;historyUnavailable:boolean}> }
const { monitors } = Astro.props;
---
<div class="monitor-overview">
{monitors.map(m=><Card class="dashboard-card monitor-entry">
  <div class="monitor-top"><div class="monitor-identity"><a href={'/service/'+m.id}>{m.name}</a><p>{m.url}</p></div><StatusBadge status={badgeStatus(m.state)} size="sm" /></div>
  <div class="monitor-summary"><div><strong class="positive">{m.uptime === null ? 'No data' : m.uptime.toFixed(2)+'%'}</strong><small>Availability · 24h</small></div><div class="monitor-metrics"><MetricItem icon="PERFORMANCE" value={m.avgPing === null ? 'No data' : Math.round(m.avgPing)+' ms'} label="average" /><MetricItem icon="ANALYTICS" value={m.totalChecks === null ? 'Unavailable' : m.totalChecks.toLocaleString()} label="checks" /></div></div>
  {m.historyUnavailable ? <p class="history-unavailable">History is unavailable. Refresh to retry.</p> : <UptimeHistoryBar buckets={m.history} compact label="24 hours" />}
  <div class="monitor-footer"><small>{m.lastCheck}</small><a href={'/service/'+m.id}>View details</a></div>
</Card>)}
</div>
<style>
.monitor-overview{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.monitor-entry{padding:20px}.monitor-top{display:flex;gap:12px;justify-content:space-between;align-items:flex-start}.monitor-identity{min-width:0}.monitor-identity a{font-size:18px;font-weight:600}.monitor-identity a:hover{text-decoration:underline}.monitor-identity p{font-size:12px;color:#a7a2bb;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:4px}.monitor-summary{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:22px 0 18px}.monitor-summary strong{display:block;font-size:26px;font-weight:600}.monitor-summary small{display:block;font-size:11px}.monitor-metrics{display:grid;gap:10px}.monitor-footer{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:14px}.monitor-footer small{font-size:10px}.monitor-footer a{color:#c4a7e7;font-size:12px}.history-unavailable{font-size:12px;color:#ebbcba}
@media(max-width:800px){.monitor-overview{grid-template-columns:1fr}}
</style>
