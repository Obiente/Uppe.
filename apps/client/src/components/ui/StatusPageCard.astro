---
import Card from './Card.astro';
import Badge from './Badge.astro';
import MetricItem from './MetricItem.astro';
interface Props { title:string;slug:string;isActive:boolean;serviceCount:number;visits:string;created:string;description?:string }
const {title,slug,isActive,serviceCount,visits,created,description}=Astro.props;
---
<Card class="dashboard-card status-page-card">
  <div class="status-page-title"><h2><a href={'/status-pages/'+slug+'/edit'}>{title}</a></h2><Badge variant={isActive?'success':'neutral'} size="sm">{isActive?'Published':'Hidden'}</Badge></div>
  <p class="page-path">/public/{slug}</p>
  {description && <p class="page-description">{description}</p>}
  <div class="page-metrics"><MetricItem icon="DASHBOARD" value={String(serviceCount)} label="services" /><MetricItem icon="ANALYTICS" value={visits} label="visits" /></div>
  <div class="page-footer"><small>Created {created}</small><div class="actions">{isActive && <a href={'/public/'+slug} target="_blank" rel="noopener">View page</a>}<a href={'/status-pages/'+slug+'/edit'} class="button secondary">Edit</a></div></div>
</Card>
<style>
.status-page-card{padding:20px}.status-page-title{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.status-page-title h2{font-size:18px;margin:0}.page-path{font-size:12px;color:#a7a2bb;overflow-wrap:anywhere;margin:4px 0 20px}.page-description{font-size:13px;color:#b4afc9;margin-bottom:20px}.page-metrics{display:flex;gap:24px;flex-wrap:wrap;margin:22px 0}.page-footer{border-top:1px solid #393552;padding-top:16px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}.page-footer small{font-size:11px}.page-footer a{font-size:12px;color:#c4a7e7}
</style>
