---
import Layout from './Layout.astro';
interface Props { title: string; description?: string }
const { title, description } = Astro.props;
const links = [['/dashboard','Monitors'],['/status-pages','Status pages'],['/analytics','History'],['/network-map','Network'],['/settings','Settings']];
---
<Layout title={`${title} | Uppe.`}>
  <header class="ops-header"><a class="wordmark" href="/dashboard">Uppe<span>.</span></a><nav aria-label="Main navigation">{links.map(([href,label]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}</nav><form action="/logout" method="post"><button class="quiet">Sign out</button></form></header>
  <main class="ops"><div class="page-heading"><div><p class="eyebrow">YOUR SERVICES, IN VIEW</p><h1>{title}</h1>{description && <p class="muted">{description}</p>}</div><slot name="actions" /></div><slot /></main>
</Layout>
<style is:global>
  .ops-header{display:flex;align-items:center;gap:32px;padding:22px max(24px,calc((100vw - 1160px)/2));border-bottom:1px solid #393552;background:#1f1d2e;color:#e0def4;flex-wrap:wrap}
  .wordmark{font-size:29px;font-weight:750;letter-spacing:-1.5px}.wordmark span{color:#c4a7e7}.ops-header nav{display:flex;gap:24px;flex:1;flex-wrap:wrap;font-size:14px}.ops-header nav a{color:#b4afc9}.ops-header nav a[aria-current]{color:#e0def4;text-decoration:underline;text-underline-offset:10px}
  .ops{max-width:1160px;margin:auto;padding:48px 24px 80px;color:#e0def4}.page-heading{display:flex;gap:20px;justify-content:space-between;align-items:center;margin-bottom:32px}.ops h1{font-size:32px;font-weight:650;letter-spacing:-.9px;margin:6px 0 8px}.ops h2{font-size:19px;font-weight:600;margin-bottom:12px}.eyebrow{color:#c4a7e7;font-size:11px;letter-spacing:2px}.muted{color:#a7a2bb;line-height:1.6}.panel{border:1px solid #393552;background:#26233a;border-radius:14px;padding:24px;margin-bottom:20px}.ops .button,.ops button[type=submit]{display:inline-flex;align-items:center;justify-content:center;border-radius:8px;padding:11px 18px;background:#c4a7e7;color:#232033;font-size:14px;font-weight:650;cursor:pointer}.ops .secondary,.quiet{background:transparent!important;color:#c4a7e7!important;border:1px solid #52486a;border-radius:8px;padding:9px 14px}.ops a:focus-visible,.ops button:focus-visible,.ops-header a:focus-visible{outline:2px solid #9ccfd8;outline-offset:5px}.ops button:disabled{opacity:.55;cursor:wait}.ops label{display:grid;gap:8px;font-size:14px;margin-bottom:20px}.ops input:not([type=checkbox]),.ops select,.ops textarea{background:#1f1d2e;border:1px solid #52486a;border-radius:8px;padding:12px;color:#e0def4;width:100%}.ops input:focus,.ops select:focus,.ops textarea:focus{outline:2px solid #c4a7e7;outline-offset:2px}.ops label.check{display:flex;align-items:center}.ops input[type=checkbox]{accent-color:#c4a7e7;width:18px;height:18px}.form-grid,.metric-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.metric-grid{grid-template-columns:repeat(3,minmax(0,1fr));margin-bottom:24px}.metric-grid strong{display:block;font-size:30px;font-weight:500;margin:8px 0}.table-wrap{overflow-x:auto}.ops table{width:100%;border-collapse:collapse;font-size:14px}.ops th{text-align:left;font-size:12px;color:#a7a2bb;font-weight:500}.ops td,.ops th{padding:16px 12px;border-bottom:1px solid #393552}.ops tbody tr:last-child td{border-bottom:0}.ops td a{color:#e0def4;text-decoration:underline;text-underline-offset:4px}.state{display:inline-block;padding:4px 9px;border-radius:6px;background:#393552;color:#d3cde7;text-transform:capitalize;font-size:12px}.state.up{color:#9ccfd8;background:#9ccfd814}.state.down,.error{color:#ebbcba}.state.degraded{color:#f6c177}.error{border:1px solid #ebbcba66;background:#ebbcba0c;padding:16px;border-radius:10px;margin-bottom:20px}.empty{padding:48px 24px;text-align:center}.actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.ops .danger{color:#ebbcba!important;border-color:#ebbcba66}.narrow{max-width:720px}.ops small{font-size:12px;color:#a7a2bb}
  @media(max-width:650px){.ops{padding-top:28px}.ops-header{gap:18px}.ops-header nav{order:3;width:100%;gap:18px}.ops-header form{margin-left:auto}.page-heading{align-items:flex-start;flex-direction:column}.metric-grid{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr;gap:0}.ops h1{font-size:28px}}
</style>
