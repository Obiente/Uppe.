---
import Operator from '../layouts/Operator.astro';
import { monitorClient,resultClient } from '../lib/api/client';
import { AggregationPeriod } from '../gen/result/v1/result_pb';
import { dateTime } from '../lib/services/health';
const monitors=await monitorClient.listMonitors({page:1,pageSize:200}).catch(()=>null);
const id=Astro.url.searchParams.get('monitor')??monitors?.monitors[0]?.id;
const end=BigInt(Math.floor(Date.now()/1000));
const history=id ? await resultClient.getAggregatedStats({monitorId:id,startTime:end-86400n,endTime:end,period:AggregationPeriod.HOUR}).catch(()=>null):null;
---
<Operator title="Check history" description="Hourly measurements from the past 24 hours.">
{!monitors ? <div class="error">Unable to load monitors. Please refresh.</div> : !monitors.monitors.length ? <div class="panel empty"><h2>No check history yet</h2><p class="muted">Create a monitor to start collecting measurements.</p><a class="button" style="margin-top:20px" href="/add-monitor">Add monitor</a></div> : <>
<form class="panel narrow" method="get"><label>Service<select name="monitor">{monitors.monitors.map(m=><option value={m.id} selected={m.id===id}>{m.name}</option>)}</select></label><button type="submit">View history</button></form>
{!history ? <div class="error">Check history is unavailable. Try again shortly.</div> : !history.dataPoints.length ? <div class="panel"><p class="muted">No measurements in this time range.</p></div> : <div class="panel table-wrap"><table><thead><tr><th>Hour (UTC)</th><th>Checks</th><th>Uptime</th><th>Average response</th></tr></thead><tbody>{history.dataPoints.map(p=><tr><td>{dateTime(p.timestamp)}</td><td>{String(p.totalChecks)}</td><td>{p.totalChecks>0n?p.uptimePercentage.toFixed(2)+'%':'No data'}</td><td>{Math.round(p.averageLatencyMs)} ms</td></tr>)}</tbody></table></div>}
</>}
</Operator>
