---
import Operator from '../layouts/Operator.astro';
import { networkClient } from '../lib/api/client';
import { dateTime } from '../lib/services/health';
import { PeerStatus } from '../gen/network/v1/network_pb';
const peers=await networkClient.listPeers({page:1,pageSize:100}).catch(()=>null);
---
<Operator title="Peer network" description="Peers observed by this node.">
{!peers ? <div class="error">Peer information is unavailable. Please refresh.</div> : !peers.peers.length ? <div class="panel empty"><h2>No peers recorded</h2><p class="muted">Local monitoring runs independently. New installations have peer networking turned off.</p></div> : <div class="panel table-wrap"><table><thead><tr><th>Peer</th><th>Last reported state</th><th>Last seen</th></tr></thead><tbody>{peers.peers.map(p=><tr><td style="max-width:450px;overflow-wrap:anywhere">{p.peerId}</td><td>{PeerStatus[p.status]?.toLowerCase()??'unknown'}</td><td>{dateTime(p.lastSeen)}</td></tr>)}</tbody></table></div>}
</Operator>
