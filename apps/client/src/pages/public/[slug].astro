---
import Layout from '../../layouts/Layout.astro';
import { publicStatusPageClient } from '../../lib/api/client';
import { Code, ConnectError } from '@connectrpc/connect';
import { ResultStatus } from '../../gen/result/v1/result_pb';
import type { PublicStatusPage } from '../../gen/publicstatuspage/v1/publicstatuspage_pb';

let page: PublicStatusPage | undefined;
let unavailable = false;
try {
  page = await publicStatusPageClient.getPublicStatusPage({ slug: Astro.params.slug ?? '' });
} catch (error) {
  unavailable = !(error instanceof ConnectError && error.code === Code.NotFound);
  Astro.response.status = unavailable ? 503 : 404;
}
const status = (value: ResultStatus) => {
  if (value === ResultStatus.UP) return 'Operational';
  if (value === ResultStatus.DEGRADED) return 'Degraded';
  if ([ResultStatus.DOWN, ResultStatus.ERROR, ResultStatus.TIMEOUT].includes(value)) return 'Disruption';
  return 'Awaiting checks';
};
const statuses = page?.monitors.map(m => status(m.status)) ?? [];
const heading = statuses.includes('Disruption') ? 'Service disruption'
  : statuses.includes('Degraded') ? 'Performance degradation'
  : statuses.length === 0 || statuses.includes('Awaiting checks') ? 'Status unavailable'
  : 'All systems operational';
const color = /^#[0-9a-fA-F]{6}$/.test(page?.primaryColor ?? '') ? page!.primaryColor : '#c4a7e7';
---
<Layout title={page?.title ?? (unavailable ? 'Status temporarily unavailable' : 'Page not found')}>
  <main class="mx-auto max-w-4xl px-6 py-14 text-primary" style={`--page-accent:${color}`}>
    {!page ? (
      <div class="rounded-xl border border-primary bg-bg-secondary p-8">
        <h1 class="text-2xl font-semibold">{unavailable ? 'Status temporarily unavailable' : 'Page not found'}</h1>
        <p class="mt-3 text-secondary">{unavailable ? 'We could not load the latest checks. Try again shortly.' : 'This status page is not published.'}</p>
      </div>
    ) : (
      <>
        <header class="mb-10 border-b border-primary pb-8">
          {page.logoUrl && <img src={page.logoUrl} alt="" referrerpolicy="no-referrer" width="64" height="64" class="mb-5 h-16 w-16 object-contain" />}
          <p class="text-sm uppercase tracking-widest text-secondary">Service status</p>
          <h1 class="mt-3 text-4xl font-semibold" style="color:var(--page-accent)">{page.title}</h1>
          {page.description && <p class="mt-4 text-secondary">{page.description}</p>}
        </header>
        <section class="mb-8 rounded-xl border border-primary bg-bg-secondary p-7" aria-label="Overall status">
          <h2 class="text-2xl font-semibold">{heading}</h2>
          <p class="mt-2 text-secondary">Current checks from the services on this page.</p>
        </section>
        <section class="space-y-4" aria-label="Services">
          {page.monitors.length === 0 && <p class="text-secondary">No services have been added yet.</p>}
          {page.monitors.map(m => (
            <article class="rounded-xl border border-primary bg-bg-secondary p-6">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 class="font-semibold text-lg">{m.name}</h2>
                <span class:list={['text-sm font-medium', { 'text-status-success': m.status === ResultStatus.UP, 'text-status-error': ['Disruption'].includes(status(m.status)), 'text-secondary': status(m.status) === 'Awaiting checks' }]}>{status(m.status)}</span>
              </div>
              <dl class="mt-5 grid grid-cols-1 gap-3 text-sm sm:grid-cols-3">
                <div><dt class="text-secondary">Uptime, last 24 hours</dt><dd class="mt-1">{Number(m.totalChecks) > 0 ? `${m.uptimePercentage.toFixed(2)}%` : 'No checks yet'}</dd></div>
                <div><dt class="text-secondary">Average response</dt><dd class="mt-1">{m.averageLatencyMs > 0 ? `${Math.round(m.averageLatencyMs)} ms` : 'Unavailable'}</dd></div>
                <div><dt class="text-secondary">Last checked</dt><dd class="mt-1">{Number(m.lastChecked) > 0 ? new Date(Number(m.lastChecked) * 1000).toLocaleString('en-GB', {timeZone:'UTC'}) + ' UTC' : 'Awaiting checks'}</dd></div>
              </dl>
            </article>
          ))}
        </section>
        <footer class="mt-12 flex items-center justify-between border-t border-primary pt-6 text-sm text-secondary">
          <span>Uppe.</span><button type="button" id="refreshStatus" class="hover:text-primary">Refresh status</button>
        </footer>
      </>
    )}
  </main>
</Layout>
<script>
  document.getElementById('refreshStatus')?.addEventListener('click', () => window.location.reload());
  setTimeout(() => { if (document.visibilityState === 'visible') window.location.reload(); }, 60_000);
</script>
