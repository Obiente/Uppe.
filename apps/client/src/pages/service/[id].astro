---
import Operator from '../../layouts/Operator.astro';
import { monitorClient,resultClient } from '../../lib/api/client';
import { health,dateTime } from '../../lib/services/health';
import { ResultStatus } from '../../gen/result/v1/result_pb';
const id = Astro.params.id ?? '';
const monitor = await monitorClient.getMonitor({id}).catch(()=>null);
let unavailable = false;
const results = monitor ? await resultClient.getResults({monitorId:id,limit:100}).catch(()=>{unavailable=true;return null;}) : null;
const now = BigInt(Math.floor(Date.now()/1000));
const stats = monitor ? await monitorClient.getMonitorStats({monitorId:id,startTime:now-86400n,endTime:now}).catch(()=>null) : null;
if (!monitor) Astro.response.status = 503;
---
<Operator title={monitor?.name ?? 'Monitor unavailable'} description={monitor?.url}>
  {monitor && <a slot="actions" class="button secondary" href={'/service/'+id+'/edit'}>Edit monitor</a>}
  {!monitor ? <div class="error">Unable to load this monitor. <a href="/dashboard">Return to monitors</a>.</div> : <>
    <div class="metric-grid"><div class="panel"><p class="muted">Current status</p><strong><span class={'state '+health(monitor,results?.results[0])}>{health(monitor,results?.results[0])}</span></strong><small>Every {monitor.intervalSeconds} seconds</small></div><div class="panel"><p class="muted">Uptime, last 24 hours</p><strong>{stats && stats.totalChecks>0n ? stats.uptimePercentage.toFixed(2)+'%' : 'No data'}</strong><small>{String(stats?.totalChecks ?? 0)} checks</small></div><div class="panel"><p class="muted">Average response, last 24 hours</p><strong>{stats && stats.totalChecks>0n ? Math.round(stats.averageLatencyMs)+' ms' : 'No data'}</strong></div></div>
    <div class="panel"><h2>Recent checks</h2>{unavailable ? <div class="error">Check history is unavailable. Please refresh.</div> : !results?.results.length ? <p class="muted">Awaiting the first check. Your node will pick up changes within 30 seconds.</p> : <div class="table-wrap"><table><thead><tr><th>Time</th><th>Result</th><th>Response</th><th>Detail</th></tr></thead><tbody>{results.results.map(r=><tr><td>{dateTime(r.timestamp)}</td><td>{ResultStatus[r.status]?.toLowerCase() ?? 'unknown'}</td><td>{r.latencyMs>0n ? r.latencyMs+' ms' : 'No measurement'}</td><td>{r.errorMessage || (r.statusCode ? 'HTTP '+r.statusCode : '')}</td></tr>)}</tbody></table></div>}</div>
    <div id="action-error" class="error" role="alert" hidden></div><div class="actions"><a class="button secondary" href={'/service/'+id}>Refresh</a><button id="toggle" class="quiet" data-id={id} data-enabled={monitor.enabled}>{monitor.enabled ? 'Pause monitoring' : 'Resume monitoring'}</button><button id="delete" class="quiet danger" data-id={id}>Delete monitor</button></div>
  </>}
</Operator>
<script>
  import { monitorClient } from '../../lib/api/client';
  for (const action of ['toggle','delete']) document.getElementById(action)?.addEventListener('click',async event=>{
    const button=event.currentTarget as HTMLButtonElement; const id=button.dataset.id!;
    if(action==='delete' && !confirm('Delete this monitor and its check history?')) return;
    button.disabled=true;
    try { if(action==='delete'){await monitorClient.deleteMonitor({id});location.assign('/dashboard');}else{await monitorClient.updateMonitor({id,enabled:button.dataset.enabled!=='true'});location.reload();} }
    catch {const error=document.getElementById('action-error')!;error.textContent='Unable to save this change. Please try again.';error.hidden=false;button.disabled=false;}
  });
</script>
