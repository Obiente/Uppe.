---
import Operator from '../../../layouts/Operator.astro';
import MonitorForm from '../../../components/MonitorForm.astro';
import { monitorClient } from '../../../lib/api/client';
const monitor = await monitorClient.getMonitor({id:Astro.params.id ?? ''}).catch(()=>null);
if (!monitor) Astro.response.status = 503;
---
<Operator title="Edit monitor">{monitor ? <MonitorForm monitor={monitor} /> : <div class="error">Unable to load this monitor. <a href="/dashboard">Return to monitors</a>.</div>}</Operator>
