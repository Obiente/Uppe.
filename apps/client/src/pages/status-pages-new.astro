---
import Operator from '../layouts/Operator.astro';
import StatusPageForm from '../components/StatusPageForm.astro';
import { monitorClient } from '../lib/api/client';
const response=await monitorClient.listMonitors({page:1,pageSize:200}).catch(()=>null);
---
<Operator title="Create status page" description="Choose the services you want to share.">
{response ? <StatusPageForm mode="create" monitors={response.monitors} /> : <div class="error">Unable to load monitors. Please refresh before creating a page.</div>}
</Operator>
