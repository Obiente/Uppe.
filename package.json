{
  "name": "@obiente/uppe",
  "version": "1.0.0",
  "description": "Monitoring that doesn't let you down!",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/run.mjs build",
    "dev": "turbo run dev",
    "dev:bootstrap": "node scripts/dev.mjs bootstrap",
    "test:scripts": "node --test scripts/runtime.test.mjs",
    "dev:server": "turbo run dev --filter=@uppe/server",
    "dev:service": "turbo run dev --filter=@uppe/service",
    "dev:client": "turbo run dev --filter=@uppe/client",
    "lint": "pnpm check",
    "proto": "buf generate",
    "test": "pnpm check",
    "proto:check": "buf lint",
    "start": "node scripts/run.mjs start",
    "check": "node scripts/check.mjs"
  },
  "keywords": [
    "uppe",
    "obiente",
    "uptime",
    "p2p",
    "monitoring",
    "decentralized"
  ],
  "author": {
    "name": "Obiente",
    "url": "https://obiente.com",
    "github": "Obiente",
    "email": "uppe@obiente.dev"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
    "turbo": "^2.7.3",
    "@bufbuild/buf": "1.63.0",
    "@bufbuild/protoc-gen-es": "2.15.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
