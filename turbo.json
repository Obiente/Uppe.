{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["UPPE_*", "HOST", "PORT", "LocalAppData", "LOCALAPPDATA", "GOCACHE", "GOPATH", "GOMODCACHE", "GOPROXY", "CARGO_HOME", "CARGO_TARGET_DIR", "RUSTUP_HOME", "RUST_LOG"],
  "tasks": {
    "//#dev:bootstrap": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "target/release/**",
        "bin/**"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "dependsOn": ["//#dev:bootstrap"],
      "persistent": true,
      "cache": false,
      "env": ["LocalAppData", "GOCACHE", "GOPATH"]
    },
    "@uppe/server#dev": {
      "dependsOn": ["//#dev:bootstrap"],
      "persistent": true,
      "cache": false,
      "interruptible": true,
      "env": ["LocalAppData", "GOCACHE", "GOPATH"]
    },
    "proto": {
      "dependsOn": [
        "^proto"
      ],
      "outputs": [
        "gen/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "deps": {
      "cache": false
    }
  }
}
